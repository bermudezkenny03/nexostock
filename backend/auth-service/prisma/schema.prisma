generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  legalName    String?  @map("legal_name")
  taxId        String?  @map("tax_id")
  primaryColor String?  @map("primary_color")
  logoUrl      String?  @map("logo_url")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users User[]
  roles Role[]

  @@map("businesses")
}

model Module {
  id          String   @id @default(uuid()) @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  code        String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  route       String?
  icon        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent      Module?      @relation("ModuleTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Module[]     @relation("ModuleTree")
  permissions Permission[]

  @@index([parentId])
  @@map("modules")
}

model Permission {
  id        String   @id @default(uuid()) @db.Uuid
  moduleId  String   @map("module_id") @db.Uuid
  code      String   @unique
  name      String
  action    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  module          Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@index([moduleId])
  @@map("permissions")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  code        String
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([businessId, code])
  @@unique([id, businessId])
  @@map("roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  businessId   String    @map("business_id") @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  detail        UserDetail?
  userRole      UserRole?
  refreshTokens RefreshToken[]

  @@unique([id, businessId])
  @@index([businessId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model UserDetail {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  phone     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_details")
}

model UserRole {
  userId     String @id @map("user_id") @db.Uuid
  roleId     String @map("role_id") @db.Uuid
  businessId String @map("business_id") @db.Uuid

  user User @relation(fields: [userId, businessId], references: [id, businessId], onDelete: Cascade)
  role Role @relation(fields: [roleId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([userId, businessId])
  @@index([roleId, businessId])
  @@map("user_roles")
}
